{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vantor Hub Account Services Accounts Items API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Collection Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.maxar.com/admin/v1/collections/:collectionId/items",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "bbox",
                "value": "",
                "type": "query"
              },
              {
                "name": "datetime",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List items belonging to a single collection."
        },
        {
          "info": {
            "name": "Get Item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.maxar.com/admin/v1/collections/:collectionId/items/:itemId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "itemId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a single STAC item, including asset hrefs."
        }
      ]
    }
  ],
  "bundled": true
}