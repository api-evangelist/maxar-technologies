{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vantor Hub Account Services Accounts Introspection API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Introspection",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Introspect Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.maxar.com/admin/v1/auth/v1/introspect",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return active/inactive status and metadata for a token."
        }
      ]
    }
  ],
  "bundled": true
}