{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vantor Hub Account Services Accounts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get My Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.maxar.com/admin/v1/accounts/me"
          },
          "docs": "Get My Account"
        },
        {
          "info": {
            "name": "Get Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.maxar.com/admin/v1/accounts/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Account"
        }
      ]
    }
  ],
  "bundled": true
}