                "name": "collections",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "cloud_cover",
                "value": "",
                "type": "query"
              },
              {
                "name": "max_resolution",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "STAC-style GET search with query parameters."
        },
        {
          "info": {
            "name": "Search Items",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.maxar.com/admin/v1/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
